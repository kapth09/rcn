# Maintainer: kapth09
pkgname=rcn
pkgver=0.0.2
pkgrel=1
pkgdesc="Remote control program to replay eventX inputs on another computer"
arch=('x86_64')
url="https://github.com/kapth09/rcn"
license=('GPL-3.0-or-later')
depends=('glibc')
makedepends=('gcc' 'make')
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=('cf9cd7fcb70f94bac0a5938593bf8a8190817711e57328458355f668e124e557')

build() {
	cd "${pkgname}"
	make standard
}

package() {
	cd "${pkgname}"
	install -Dm 0755 rcn "${pkgdir}/usr/bin/rcn"
	install -Dm 0644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
